
# --- Product automation (AI) ------------------------------------------------
# Without GEMINI_API_KEY the system falls back to clearly labelled DEV FIXTURE
# providers, whose output cannot be published.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Override provider selection: "gemini" (default) or "fixture".
AI_TEXT_PROVIDER=
AI_IMAGE_PROVIDER=

# --- Preview isolation ------------------------------------------------------
# Vercel Preview deployments share variables with Production unless scoped
# apart. A preview prefers these separately named, Preview-only variables, and
# draft creation is REFUSED on a preview that has no database of its own.
MONGODB_URI_PREVIEW=
MONGODB_DB_NAME_PREVIEW=leihfluss_preview_qa
# Cloudinary folder for product images (default: leihfluss/products).
CLOUDINARY_PRODUCT_FOLDER_PREVIEW=leihfluss/preview-qa
# Preview-only JWT secret, so tokens minted on a preview are not valid against
# production. Applied at startup by api/index.js on preview deployments only.
JWT_SECRET_PREVIEW=
# ---------------------------------------------------------------------------
# Leihfluss backend configuration.
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=mietlyplus

# Signing key for user and admin JWTs. There is NO fallback: if this is unset,
# signin, signup and every admin route return HTTP 500. Use a long random value
# (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook endpoint. Obtain it when registering
# the endpoint below; without it, webhook deliveries are rejected with HTTP 500
# and orders are only confirmed by the success page.
#
#   Endpoint URL: https://<backend-host>/api/payments/stripe-webhook
#   Events:       checkout.session.completed
#                 checkout.session.async_payment_succeeded
#                 checkout.session.async_payment_failed
#                 checkout.session.expired
#
# Local testing: stripe listen --forward-to localhost:5000/api/payments/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# --- URLs -------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
PORT=5000

# --- Cloudinary (admin image uploads) ---------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Leihfluss
SUPPORT_REQUEST_RECIPIENT_EMAIL=

# --- Auth providers ---------------------------------------------------------
GOOGLE_CLIENT_ID=

# --- Scheduled rental reminders ---------------------------------------------
CRON_SECRET=
RENTAL_REMINDER_INTERVAL_MINUTES=60
SIGNUP_OTP_EXPIRES_MINUTES=10

# --- Admin seeding (scripts/create-admin.js, local/ops use only) ------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
