
# --- Product automation (AI) ------------------------------------------------
# Without GEMINI_API_KEY the system falls back to clearly labelled DEV FIXTURE
# providers, whose output cannot be published.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Override provider selection: "gemini" (default) or "fixture".
AI_TEXT_PROVIDER=
AI_IMAGE_PROVIDER=
