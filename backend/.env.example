
# --- Product automation (AI) ------------------------------------------------
# Without GEMINI_API_KEY the system falls back to clearly labelled DEV FIXTURE
# providers, whose output cannot be published.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Override provider selection: "gemini" (default) or "fixture".
AI_TEXT_PROVIDER=
AI_IMAGE_PROVIDER=

# --- Preview isolation ------------------------------------------------------
# Vercel Preview deployments share variables with Production unless scoped
# apart. A preview prefers these separately named, Preview-only variables, and
# draft creation is REFUSED on a preview that has no database of its own.
MONGODB_URI_PREVIEW=
MONGODB_DB_NAME_PREVIEW=leihfluss_preview_qa
# Cloudinary folder for product images (default: leihfluss/products).
CLOUDINARY_PRODUCT_FOLDER_PREVIEW=leihfluss/preview-qa
