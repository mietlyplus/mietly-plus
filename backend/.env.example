# ---------------------------------------------------------------------------
# Leihfluss backend configuration.
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=mietlyplus

# Signing key for user and admin JWTs. There is NO fallback: if this is unset,
# signin, signup and every admin route return HTTP 500. Use a long random value
# (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook endpoint. Obtain it when registering
# the endpoint below; without it, webhook deliveries are rejected with HTTP 500
# and orders are only confirmed by the success page.
#
#   Endpoint URL: https://<backend-host>/api/payments/stripe-webhook
#   Events:       checkout.session.completed
#                 checkout.session.async_payment_succeeded
#                 checkout.session.async_payment_failed
#                 checkout.session.expired
#
# Local testing: stripe listen --forward-to localhost:5000/api/payments/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# --- URLs -------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
PORT=5000

# --- Cloudinary (admin image uploads) ---------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Leihfluss
SUPPORT_REQUEST_RECIPIENT_EMAIL=

# --- Auth providers ---------------------------------------------------------
GOOGLE_CLIENT_ID=

# --- Scheduled rental reminders ---------------------------------------------
CRON_SECRET=
RENTAL_REMINDER_INTERVAL_MINUTES=60
SIGNUP_OTP_EXPIRES_MINUTES=10

# --- Admin seeding (scripts/create-admin.js, local/ops use only) ------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
